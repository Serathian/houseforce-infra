# ==============================================================================
# HouseForce Infrastructure Deployment Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Ingress & Host Routing
# ------------------------------------------------------------------------------
# GitHub owner / organization where GHCR packages are hosted
GITHUB_OWNER=Serathian

# Primary domain name (e.g. houseforce.es in production, test.houseforce.es in test)
DOMAIN=houseforce.es

# Let's Encrypt Email for ACME SSL certificate issuance
ACME_EMAIL=admin@houseforce.es

# Traefik Dashboard Basic Auth (htpasswd format, escape $ with $$, e.g. admin:$$apr1$$...)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz...

# Secret token for Watchtower instant update webhook (/v1/update)
WATCHTOWER_TOKEN=replace_with_secure_random_hex

# ------------------------------------------------------------------------------
# 2. Strapi Backend Application Keys & Secrets
# ------------------------------------------------------------------------------
HOUSEFORCE_STRAPI_APP_KEYS=replace_with_comma_separated_keys
HOUSEFORCE_STRAPI_API_TOKEN_SALT=replace_with_salt
HOUSEFORCE_STRAPI_ADMIN_JWT_SECRET=replace_with_admin_secret
HOUSEFORCE_STRAPI_TRANSFER_TOKEN_SALT=replace_with_transfer_salt
HOUSEFORCE_STRAPI_JWT_SECRET=replace_with_jwt_secret

# ------------------------------------------------------------------------------
# 3. Database Configuration
# Production: DigitalOcean Managed PostgreSQL
# Test: Automatically overridden to local postgres container by docker-compose.test.yml
# ------------------------------------------------------------------------------
DATABASE_HOST=db-postgresql-nyc1-houseforce.ondigitalocean.com
DATABASE_PORT=25060
DATABASE_NAME=defaultdb
DATABASE_USERNAME=doadmin
DATABASE_PASSWORD=replace_with_managed_db_password
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 4. Media Storage (DigitalOcean Spaces / S3)
# Production: DigitalOcean Spaces S3 bucket
# Test: Automatically overridden to local MinIO container by docker-compose.test.yml
# ------------------------------------------------------------------------------
DO_SPACE_ACCESS_KEY=replace_with_do_spaces_access_key
DO_SPACE_SECRET_KEY=replace_with_do_spaces_secret_key
DO_SPACE_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACE_BUCKET=houseforce-uploads
DO_SPACE_REGION=us-east-1
DO_SPACE_DIRECTORY=uploads

# ------------------------------------------------------------------------------
# 5. Customer Portal & NextAuth Configuration
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=replace_with_nextauth_secret_32_chars
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# ------------------------------------------------------------------------------
# 6. Postmark Email Service Desk
# ------------------------------------------------------------------------------
POSTMARK_API_TOKEN=replace_with_postmark_token
EMAIL_DOMAIN=replies.houseforce.es
EMAIL_DEFAULT_FROM=updates@replies.houseforce.es
